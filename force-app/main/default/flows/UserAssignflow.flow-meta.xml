        <label>Check If permission set Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Permission set Not found</defaultConnectorLabel>
        <rules>
            <name>Permission_set_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Permission_set_Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_user</targetReference>
            </connector>
            <label>Permission set found</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Exist</name>
        <label>User Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>User Not found</defaultConnectorLabel>
        <rules>
            <name>User_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Permission_set_Id</targetReference>
            </connector>
            <label>User found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
