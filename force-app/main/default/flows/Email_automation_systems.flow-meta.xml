    <environments>Default</environments>
    <formulas>
        <name>Birthdayistoday</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(DAY(TODAY()) =DAY({!$Record.Date_of_Birth__c}),  MONTH(TODAY())=MONTH({!$Record.Date_of_Birth__c})),TRUE,FALSE
)</expression>
    </formulas>
    <formulas>
        <name>Workanniversary</name>
        <dataType>Boolean</dataType>
