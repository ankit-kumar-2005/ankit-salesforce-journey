<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Experience_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Total Experience must be greater than 0.</description>
    <errorConditionFormula>OR(
  ISBLANK(Total_Experience__c),
  Total_Experience__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Total Experience must be greater than 0.</errorMessage>
</ValidationRule>
