<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Joining_Date_Not_Future</fullName>
    <active>true</active>
    <description>Joining Date cannot be in the future.</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Joining_Date__c)),
  Joining_Date__c &gt; TODAY()
)</errorConditionFormula>
    <errorMessage>Joining Date cannot be in the future.</errorMessage>
</ValidationRule>
