<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Project_OR_Date_Not_Blank</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    ISBLANK(Project__c),
    ISBLANK(Date__c)
)</errorConditionFormula>
    <errorMessage>Project and Date cannot be blank</errorMessage>
</ValidationRule>
