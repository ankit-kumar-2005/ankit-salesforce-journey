<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ensure_Email_and_Phone_are_filled_before</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
   IsConverted,
   OR(
      ISBLANK(Email),
      ISBLANK(Phone)
   )
)</errorConditionFormula>
    <errorMessage>Ensure Email and Phone are filled before conversion</errorMessage>
</ValidationRule>
