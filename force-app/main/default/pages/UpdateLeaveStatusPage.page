<apex:page standardController="Leave__c" recordSetVar="leaves" extensions="UpdateLeaveStatusController">
    <apex:form >
        <apex:pageMessages id="msgs"/>

        <apex:pageBlock title="Update Leave Status">
            <!-- Selected records table -->
            <apex:pageBlockTable id="selTable" value="{!selected}" var="leave">
                <apex:column headerValue="Employee">
                    <apex:outputField value="{!leave.Employee_Name__c}" />
                </apex:column>
                <apex:column headerValue="Leave Request">
                    <apex:outputField value="{!leave.Name}" />
                </apex:column>
                <apex:column headerValue="Current Status">
                    <apex:outputField value="{!leave.Leave_Status__c}" />
                </apex:column>
            </apex:pageBlockTable>

            <apex:pageBlockSection columns="1">
                <apex:outputLabel value="New Status:" for="statusPicklist"/>
                <apex:selectList id="statusPicklist" value="{!newStatus}" size="1">
                    <apex:selectOption itemValue="" itemLabel="--Select--" />
                    <apex:selectOption itemValue="Approved" itemLabel="Approved" />
                    <apex:selectOption itemValue="Rejected" itemLabel="Rejected" />
                </apex:selectList>
            </apex:pageBlockSection>

            <apex:pageBlockButtons >
                <apex:commandButton value="Update Status" action="{!updateStatus}" rerender="msgs,selTable"/>
                <apex:commandButton value="Cancel" action="{!cancel}" immediate="true" rerender="msgs"/>
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>